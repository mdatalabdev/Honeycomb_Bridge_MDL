# Env vars for the `api` and `auth-db` containers (docker-compose.yml) — the
# containerized counterpart to auth/.env, which still drives main.py on a host run.
# Gitignored (matches the existing `.env` rule).

# --- auth-db (postgres:15, honeycomb-net) ---
# A fresh database, not the host-installed Postgres auth/.env points at (localhost:5435,
# user myuser4/mydatabase4) — its own volume (auth-db-data), starts empty, and gets
# its schema from auth/init_db.py on first boot.
POSTGRES_USER=honeycomb_auth
POSTGRES_PASSWORD=08f9ccfc552c610aab7678d3a17d39151acb2595d4c549fd
POSTGRES_DB=honeycomb_auth
DATABASE_URL=postgresql://honeycomb_auth:08f9ccfc552c610aab7678d3a17d39151acb2595d4c549fd@auth-db:5435/honeycomb_auth

# --- auth JWT settings (from auth/.env) ---
SECRET_KEY=4Hr9D1zY3c5W8sm1Ltx2VpF7Er9bq2r_Xa4iw-gyVYk
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- default admin bootstrap (from auth/.env; see caveat re: who runs this in-container) ---
DEFAULT_ADMIN_EMAIL=admin@mdl.com
DEFAULT_ADMIN_SECRET=grse2024
